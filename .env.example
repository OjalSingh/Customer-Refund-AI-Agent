# Which model backend to use: ollama (default, fully local), anthropic, openai, offline
LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b

# Ollama (local, nothing leaves the machine)
# OLLAMA_URL=http://localhost:11434
# EMBEDDING_MODEL=all-minilm:latest

# Anthropic (pip install ".[hosted]" or pip install anthropic)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint (Gemini by default, or Groq, vLLM, LM Studio)
# LLM_PROVIDER=openai
# LLM_MODEL=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=
